# my extra functions
###############################################################################

# Edit a manuscript
function vibk () {
    local files
    files=$(fd . ~/Documents/Notes/Books | fzf -m --preview-window="60%:wrap")
    if [ -n "$files" ]; then
        $EDITOR $files
    fi
}

