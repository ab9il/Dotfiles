# Edit a manuscript
function vibk () {
    local files
    files=$(fd . ~/Documents/Notes/Books | fzf -m --preview-window="60%:wrap")
    if [ -n "$files" ]; then
        $EDITOR $files
    fi
}

# Convert Markdown files to other documents
function mkodt () {
    infile=$1
    filename_only="${1##*/}"
    basename_only="${filename_only%.*}"
    outfile="$HOME"/"$basename_only.odt"
    template="$HOME/.local/share/pandoc/reference-6x9-document.odt"

    if [ -n "$infile" ]; then
        pandoc -s $1 --output "$outfile" --reference-doc="$template"
    fi
}

